# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# local sqlite data
/prisma/*.db
/prisma/*.db-journal

# local corpus long-run artifacts
/data/corpus/inbox/*.jsonl
/data/corpus/logs
/data/corpus/runs
/data/corpus/processed

# local ecosystem autonomy artifacts
/data/ecosystem/inbox/*.jsonl
/data/ecosystem/runs
/data/ecosystem/network-runs
/data/ecosystem/network-chain
/data/ecosystem/network-sources.json

# local meaning market artifacts
/data/market/anchors
/data/market/logs
/data/market/snapshots

# local scratch artifacts
/.tmp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
